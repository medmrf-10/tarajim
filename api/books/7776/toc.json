{"id": 7776, "slug": "رسالة-في-فضل-الخلفاء-الراشدين", "title": "رسالة في فضل الخلفاء الراشدين", "author": "ابن تيمية", "death": "728", "toc": [{"i": 0, "t": "ما يجب أن يعمله المفضل", "d": 0, "pg": 30, "j": null, "sz": 577}, {"i": 1, "t": "فضائل الصديق مختصة", "d": 0, "pg": 30, "j": null, "sz": 577}, {"i": 2, "t": "أصح حديث في فضل علي والرد على النواصب", "d": 0, "pg": 37, "j": null, "sz": 569}, {"i": 3, "t": "أحب الناس إلى رسول الله ﷺ -", "d": 0, "pg": 39, "j": null, "sz": 311}, {"i": 4, "t": "القول في تشبيه علي بهارون", "d": 0, "pg": 40, "j": null, "sz": 180}, {"i": 5, "t": "تخصيص علي بنبذ العهود ليست من الخصائص", "d": 0, "pg": 42, "j": null, "sz": 882}, {"i": 6, "t": "تشبيه بعض الصحابة بالأنبياء ليس مطلقا", "d": 0, "pg": 43, "j": null, "sz": 505}, {"i": 7, "t": "معنى الموالاة في حديث \"من كنت مولاه\"", "d": 0, "pg": 47, "j": null, "sz": 880}, {"i": 8, "t": "حديث غدير خم ليس من الخصائص", "d": 0, "pg": 48, "j": null, "sz": 678}, {"i": 9, "t": "هل آية المباهلة من خصائص علي؟", "d": 0, "pg": 50, "j": null, "sz": 370}, {"i": 10, "t": "معنى (الأنفس) في القرآن", "d": 0, "pg": 51, "j": null, "sz": 583}, {"i": 11, "t": "آية المخاصمة ليست من الخصائص", "d": 0, "pg": 52, "j": null, "sz": 157}, {"i": 12, "t": "سورة الإنسان ليست خاصة بهم", "d": 0, "pg": 54, "j": null, "sz": 604}]}