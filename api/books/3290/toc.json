ون\" و\"جوزفين\" في ذلك الوقت معلقة بالاير الصغير ابن \"لويس\" و\"هورتنس\"، وشاع في كل فرنسا وهولندا أنه سيكون صاحب الملك من بعد عمه.", "d": 1, "pg": 136}, {"i": 172, "t": "حرف الحاء", "d": 0, "pg": 146}, {"i": 173, "t": "الحارثية ابن زيد", "d": 1, "pg": 146}, {"i": 174, "t": "حبابة جارية يزيد بن عبد الملك بن مروان الأموي", "d": 1, "pg": 146}, {"i": 175, "t": "حبيبة هانم بنت علي باشا الهرسكي", "d": 1, "pg": 147}, {"i": 176, "t": "حبوس ابنة الامير بشير بن محمد الشهابي", "d": 1, "pg": 147}, {"i": 177, "t": "حبيبة بنت مالك بن بدر", "d": 1, "pg": 148}, {"i": 178, "t": "حبيبة بنت عبد العزى العوراء", "d": 1, "pg": 148}, {"i": 179, "t": "حدقة جارية الملك الناصر بن قلاون", "d": 1, "pg": 149}, {"i": 180, "t": "حسانة النميرية ابنة أبي الحسين الشاعر الأندلسي", "d": 1, "pg": 149}, {"i": 181, "t": "حفصة ابنة حمدون", "d": 1, "pg": 150}, {"i": 182, "t": "حفصة ابنة الحجاج الركونية", "d": 1, "pg": 150}, {"i": 183, "t": "حليمة الحضرية", "d": 1, "pg": 154}, {"i": 184, "t": "حمدونية بنت عيسى بن موسى", "d": 1, "pg": 155}, {"i": 185, "t": "حمد بنت زياد", "d": 1, "pg": 155}, {"i": 186, "t": "حنة ألبرت", "d": 1, "pg": 159}, {"i": 187, "t": "حنة اليصابات زوجة ألنبرو", "d": 1, "pg": 159}, {"i": 188, "t": "حنة إسكو خاتون", "d": 1, "pg": 160}, {"i": 189, "t": "حنة ملكة بريطانيا وإرلانده", "d": 1, "pg": 160}, {"i": 190, "t": "حنة النمساوية ملكة فرنسا", "d": 1, "pg": 161}, {"i": 191, "t": "حنة يولين ملكة إنكلترا", "d": 1, "pg": 161}, {"i": 192, "t": "حنة البريطانية ملكة فرنسا", "d": 1, "pg": 162}, {"i": 193, "t": "حنة ملكة نابولي", "d": 1, "pg": 162}, {"i": 194, "t": "وسنة ١٣٧٨م، لما اختلف البابوان المتناظران وهما \"إكليمنفس السابع\" و\"أوريانوس السادس\" تحزبت حنة \"لإكليمنفس\" فغاظت بذلك \"أوريانوس\" فاستحضر حالا الدوق \"دورنسوا\" وأعلن أن له الحق في تخت \"نابلي\"، أما حنة فاتباعا لرأي \"إكليمنفس\" كتبت وصية مخصوصة جعلت بموجبها ابن ملك فرنسا الثاني وارثا لها ونزعت بالكلية حق الملك عن الدوق وزوجته فاتخذ \"شارل دورنسوا\" هذه الحوادث حجة كان يطلبها بعد زمان طويل فأغار على بلاد حنة ولم يصادف من الشعب إلا مقاومة قليلة وتقدم إلى \"نابلي\" وأسر الملكة وأرسلها تحت الحفظ ل \"أمور\" فكانت هناك تحت رحمة الملك \"هنكاريا\" فأمر بقتلها حالا، فقطعت بالوسائد أخذا بثأر \"أندرو\" على الطريق التي قتلته بها.", "d": 1, "pg": 163}, {"i": 195, "t": "حنة ملكة نابلي ابنة شارل دورتو", "d": 1, "pg": 163}, {"i": 196, "t": "حنة مورندي منزوليني", "d": 1, "pg": 164}, {"i": 197, "t": "حرف الخاء", "d": 0, "pg": 165}, {"i": 198, "t": "خديجة ابنة خويلد بن أسد بن عبد العزى بن قصي بن كلاب", "d": 1, "pg": 165}, {"i": 199, "t": "خديجة ملكة جزائر زيبة المهل من بلاد الهند", "d": 1, "pg": 167}, {"i": 200, "t": "خرقاء بنت النعمان بن المنذر", "d": 1, "pg": 168}, {"i": 201, "t": "حزانة ابن خالد بن جعفر بن قرط", "d": 1, "pg": 168}, {"i": 202, "t": "خماني ابنة أردشير بن بهمن", "d": 1, "pg": 169}, {"i": 203, "t": "خولة بنت الأزور الكندي", "d": 1, "pg": 169}, {"i": 204, "t": "خولة ابنة منظور بن زبان", "d": 1, "pg": 172}, {"i": 205, "t": "الخيرزان ابنة عطاء أم الهادي والرشيد", "d": 1, "pg": 173}, {"i": 206, "t": "حرف الدال", "d": 0, "pg": 174}, {"i": 207, "t": "دارمية الجونية", "d": 1, "pg": 174}, {"i": 208, "t": "دختنوس ابنة لقيط بن زرارة بن عباس الدرامي", "d": 1, "pg": 175}, {"i": 209, "t": "دلوكة بنت زباء ملكة من ملوك القبط الأولين بمصر", "d": 1, "pg": 176}, {"i": 210, "t": "دليلة الفلسطينية", "d": 1, "pg": 177}, {"i": 211, "t": "دنانير جارية يحيى بن خالد البرمكي", "d": 1, "pg": 177}, {"i": 212, "t": "دهيا بانة ثابت بن تيفان", "d": 1, "pg": 178}, {"i": 213, "t": "ديدرون ابنة الملك بقلوس", "d": 1, "pg": 179}, {"i": 214, "t": "حرف الذال", "d": 0, "pg": 180}, {"i": 215, "t": "ذات الخال", "d": 1, "pg": 180}, {"i": 216, "t": "ذبية بنت ثبية الفهمية", "d": 1, "pg": 181}, {"i": 217, "t": "ذؤابة امرأة رباح القيسي", "d": 1, "pg": 181}, {"i": 218, "t": "حرف الراء", "d": 0, "pg": 181}, {"i": 219, "t": "راحاب الإسرائيلية", "d": 1, "pg": 181}, {"i": 220, "t": "راحيل ابنة لابان", "d": 1, "pg": 182}, {"i": 221, "t": "رادغنده ابنة برنير ملك تورتجه", "d": 1, "pg": 182}, {"i": 222, "t": "رادكليف مؤلفة إنكليزية", "d": 1,