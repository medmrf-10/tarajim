ضرت عنده وقالت له أنت تعلم ما يعتقده أخي فيك وإنه متى تمكن منك لا يبقي عليك، وأنا كذلك وقد انضاف إلى هذا ما تظاهر به مما يكره المسلمون ولا يصبرون عليه، وأخاف أن يثوروا به، فيهلك هو ونحن معه، وتنقلع هذه الدولة فأجابها إلى ما تريد فقالت إنه يصعد إلى هذا الجبل غدا وليس معه غلام إلا الركاب وصبي وينفرد بنفسه فتقيم رجلين تثق بهما يقتلانه ويقتلان الصبي ونقيم ولده بعده وتكون أنت مدير الدولة وأزيد في إقطاعك مائة ألف دينار، ثم أعطته ألف دينار للرجلين، وانصرفت. فاختار اثنين من ثقاته وأخبرهما بالقصة فمضيا إلى الجبل.", "d": 1, "pg": 225}, {"i": 278, "t": "سجاح بنت الحارث بن سويد بن عقفان التميمية", "d": 1, "pg": 225}, {"i": 279, "t": "سرى خانم", "d": 1, "pg": 227}, {"i": 280, "t": "سعدى معشوقة مالك بن عقيل العذري.", "d": 1, "pg": 227}, {"i": 281, "t": "سعدى الأسدية", "d": 1, "pg": 228}, {"i": 282, "t": "سفانة ابنة حاتم الطائي", "d": 1, "pg": 229}, {"i": 283, "t": "سكينة ابنة الحسين بن علي بن أبي طالب كرم الله وجهه", "d": 1, "pg": 229}, {"i": 284, "t": "سلمى الملقبة ب\"قرة العين\"", "d": 1, "pg": 234}, {"i": 285, "t": "سلمى امرأة عروة بن الورد", "d": 1, "pg": 234}, {"i": 286, "t": "سلامة القس", "d": 1, "pg": 235}, {"i": 287, "t": "سميراميس ملكة أشور", "d": 1, "pg": 236}, {"i": 288, "t": "سمية أم عمار بن ياسر", "d": 1, "pg": 237}, {"i": 289, "t": "سودة بنت زمعة", "d": 1, "pg": 237}, {"i": 290, "t": "سودة ابنة عمار بن الأشتر الهمدانية", "d": 1, "pg": 238}, {"i": 291, "t": "سوسن زوجة بواكيم ملكة بني إسرائيل", "d": 1, "pg": 239}, {"i": 292, "t": "شجرة الدر", "d": 1, "pg": 240}, {"i": 293, "t": "شعانين زوجة المتوكل الخليفة العباسي", "d": 1, "pg": 240}, {"i": 294, "t": "شعوانة رضي الله عنها", "d": 1, "pg": 241}, {"i": 295, "t": "الشلبية الأندلسية", "d": 1, "pg": 241}, {"i": 296, "t": "شهدة ابنة أبي نصر أحمد بن أبي الفرج الإبري الدينورية البغدادية", "d": 1, "pg": 241}, {"i": 297, "t": "شوكار قاضن", "d": 1, "pg": 242}, {"i": 298, "t": "شرفية ابنة سعيد قبودان", "d": 1, "pg": 243}, {"i": 299, "t": "شرين زوجة أبروزير بن هرمز", "d": 1, "pg": 245}, {"i": 300, "t": "حرف الصاد", "d": 0, "pg": 2